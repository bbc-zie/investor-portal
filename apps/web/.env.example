# Copy this file to apps/web/.env for local frontend testing.
# Safe default keeps dev auth disabled.
VITE_API_URL=/api
VITE_DEV_AUTH=false
VITE_DEV_AUTH_ROLE=ADMIN
VITE_DEV_AUTH_TIER=APPROVED_INVESTOR
VITE_DEV_AUTH_STATUS=ACTIVE

# User Management local admin testing:
# VITE_API_URL=/api
# VITE_DEV_AUTH=true
# VITE_DEV_AUTH_ROLE=ADMIN
# VITE_DEV_AUTH_TIER=APPROVED_INVESTOR
# VITE_DEV_AUTH_STATUS=ACTIVE
